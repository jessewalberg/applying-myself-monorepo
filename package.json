{
  "name": "applying-myself-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack --experimental-https",
    "dev:clean": "rm -rf .next && npm run dev",
    "build": "next build && next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "generate-api": "npx convex-helpers ts-api-spec --output-file convexApi",
    "postbuild": "next-sitemap",
    "sitemap": "next-sitemap",
    "validate-seo": "node scripts/validate-seo.js",
    "dev:staging": "NODE_ENV=staging next dev",
    "build:staging": "NODE_ENV=staging next build",
    "deploy:staging": "vercel --target staging",
    "deploy:production": "vercel --prod"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.87",
    "@heroicons/react": "^2.2.0",
    "autoprefixer": "^10.4.21",
    "convex": "^1.24.8",
    "lucide-react": "^0.513.0",
    "next": "15.3.3",
    "next-sitemap": "^4.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}