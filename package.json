{
  "name": "applying-myself-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:web && bun run build:extension && bun run build:convex",
    "build:web": "bun run --cwd apps/web build",
    "build:extension": "bun run --cwd apps/extension build:prod",
    "build:convex": "bun run --cwd apps/convex build",
    "lint": "bun run lint:web && bun run lint:extension",
    "lint:web": "bun run --cwd apps/web lint",
    "lint:extension": "bun run --cwd apps/extension lint",
    "typecheck": "bun run typecheck:web && bun run typecheck:extension && bun run typecheck:convex",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "typecheck:extension": "bun run --cwd apps/extension type-check",
    "typecheck:convex": "bun run --cwd apps/convex typecheck",
    "convex:dev": "CI=1 bun run --cwd apps/convex dev",
    "convex:dev:once": "CI=1 bun run --cwd apps/convex dev -- --once",
    "convex:deploy": "CI=1 bun run --cwd apps/convex deploy",
    "convex:typecheck": "CI=1 bun run --cwd apps/convex typecheck",
    "check:api-contract": "bun run scripts/check-api-contract.ts",
    "check:bundle-size:extension": "bun run scripts/check-extension-bundle-size.ts",
    "sync:convex-client": "bun run scripts/sync-convex-client.ts",
    "ops:protect-branch": "bash scripts/apply-branch-protection.sh",
    "smoke": "bash scripts/run-smoke-checklist.sh"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "convex": "^1.32.0"
  }
}
