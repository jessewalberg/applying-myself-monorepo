{
  "name": "@applyingmyself/extension",
  "version": "1.0.0",
  "description": "AI-powered cover letter generator Chrome extension",
  "scripts": {
    "dev": "wxt --mode development",
    "dev:clean": "bun run clean && bun run dev",
    "build": "wxt build --mode production",
    "build:dev": "wxt build --mode development",
    "build:staging": "wxt build --mode staging",
    "build:prod": "wxt build --mode production",
    "clean": "wxt clean",
    "zip": "wxt zip --mode production",
    "zip:staging": "wxt zip --mode staging",
    "zip:prod": "wxt zip --mode production",
    "type-check": "wxt prepare && tsc --noEmit",
    "lint": "eslint src entrypoints --ext .ts,.tsx",
    "lint:fix": "eslint src entrypoints --ext .ts,.tsx --fix",
    "update-config": "bun scripts/update-config.js",
    "check-config": "bun scripts/check-config.js",
    "generate-api": "bun run --cwd ../.. sync:convex-client",
    "generate-icons": "bun scripts/generate-icons.js",
    "deploy": "bun scripts/deploy.js",
    "setup": "bun install && bun run build:dev && echo Extension built successfully. Load the dist/ folder in Chrome.",
    "start": "bun run dev",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@applyingmyself/convex-client": "workspace:*",
    "@applyingmyself/runtime-config": "workspace:*",
    "@clerk/chrome-extension": "^2.9.9",
    "convex": "^1.32.0",
    "convex-helpers": "^0.1.94",
    "docx": "^9.5.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.263.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.248",
    "@types/node": "^20.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wxt-dev/module-react": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "sharp": "^0.34.2",
    "typescript": "^5.2.0",
    "wxt": "^0.20.18"
  }
}
