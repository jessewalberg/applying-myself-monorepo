{
    "name": "Applying Myself - AI-Powered Cover Letters",
    "short_name": "Applying Myself",
    "description": "Generate personalized cover letters with AI technology. Upload your resume and let Applying Myself create compelling cover letters tailored to any job posting.",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#7c3aed",
    "orientation": "portrait-primary",
    "scope": "/",
    "lang": "en",
    "dir": "ltr",
    "categories": [
        "business",
        "productivity",
        "utilities"
    ],
    "screenshots": [
        {
            "src": "/screenshots/desktop-home.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide",
            "label": "Applying Myself homepage on desktop"
        },
        {
            "src": "/screenshots/mobile-home.png",
            "sizes": "360x640",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "Applying Myself homepage on mobile"
        }
    ],
    "icons": [
        {
            "src": "/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable any"
        },
        {
            "src": "/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable any"
        }
    ],
    "shortcuts": [
        {
            "name": "Generate Cover Letter",
            "short_name": "Generate",
            "description": "Create a new AI-powered cover letter",
            "url": "/dashboard/cover-letters/new",
            "icons": [
                {
                    "src": "/icons/shortcut-generate.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Upload Resume",
            "short_name": "Upload",
            "description": "Add a new resume to your profile",
            "url": "/dashboard/resumes/upload",
            "icons": [
                {
                    "src": "/icons/shortcut-upload.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "View Jobs",
            "short_name": "Jobs",
            "description": "Manage your job applications",
            "url": "/dashboard/jobs",
            "icons": [
                {
                    "src": "/icons/shortcut-jobs.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Dashboard",
            "short_name": "Dashboard",
            "description": "Access your main dashboard",
            "url": "/dashboard",
            "icons": [
                {
                    "src": "/icons/shortcut-dashboard.png",
                    "sizes": "96x96"
                }
            ]
        }
    ],
    "related_applications": [
        {
            "platform": "webapp",
            "url": "https://applyingmyself.com"
        }
    ],
    "id": "applying-myself-app",
    "prefer_related_applications": false,
    "edge_side_panel": {
        "preferred_width": 400
    },
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "handle_links": "preferred",
    "capture_links": "new-client",
    "file_handlers": [
        {
            "action": "/dashboard/resumes/upload",
            "accept": {
                "application/pdf": [
                    ".pdf"
                ],
                "application/msword": [
                    ".doc"
                ],
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
                    ".docx"
                ]
            }
        }
    ],
    "protocol_handlers": [
        {
            "protocol": "web+applyingmyself",
            "url": "/dashboard?action=%s"
        }
    ],
    "share_target": {
        "action": "/dashboard/jobs/new",
        "method": "GET",
        "params": {
            "title": "job_title",
            "text": "job_description",
            "url": "job_url"
        }
    },
    "display_override": [
        "window-controls-overlay",
        "minimal-ui"
    ],
    "permissions": [
        "storage"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*.png",
                "screenshots/*.png"
            ],
            "matches": [
                "https://applyingmyself.com/*"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "chrome_url_overrides": {},
    "externally_connectable": {
        "matches": [
            "https://applyingmyself.com/*"
        ]
    },
    "web_accessible_resources_v2": [],
    "chrome_settings_overrides": {},
    "optional_permissions": [
        "clipboardWrite"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "applying-myself@applyingmyself.com"
        }
    },
    "applications": {
        "gecko": {
            "id": "applying-myself@applyingmyself.com"
        }
    },
    "sidebar_action": {
        "default_title": "Applying Myself",
        "default_panel": "/dashboard"
    },
    "chrome_url_overrides_v2": {},
    "minimum_chrome_version": "88",
    "offline_enabled": false,
    "omnibox": {
        "keyword": "applyingmyself"
    },
    "options_page": "/dashboard/settings",
    "version_name": "1.0.0",
    "update_url": "https://clients2.google.com/service/update2/crx",
    "differential_fingerprint": "",
    "related_applications_v2": [
        {
            "platform": "chrome_web_store",
            "url": "https://chrome.google.com/webstore/detail/applying-myself-extension/",
            "id": "applying-myself-chrome-extension"
        }
    ]
}