{
  "name": "@applyingmyself/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack --experimental-https",
    "dev:clean": "rm -rf .next && bun run dev",
    "build": "next build && next-sitemap",
    "start": "next start",
    "lint": "eslint app components",
    "generate-api": "bun run --cwd ../.. sync:convex-client",
    "postbuild": "next-sitemap",
    "sitemap": "next-sitemap",
    "validate-seo": "bun scripts/validate-seo.js",
    "dev:staging": "NODE_ENV=staging next dev",
    "build:staging": "NODE_ENV=staging next build",
    "deploy:staging": "vercel --target staging",
    "deploy:production": "vercel --prod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@applyingmyself/convex-client": "workspace:*",
    "@applyingmyself/runtime-config": "workspace:*",
    "@applyingmyself/ui": "workspace:*",
    "@clerk/nextjs": "^6.39.0",
    "@heroicons/react": "^2.2.0",
    "@vercel/analytics": "^1.5.0",
    "autoprefixer": "^10.4.21",
    "convex": "^1.32.0",
    "docx": "^9.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.513.0",
    "next": "15.3.8",
    "next-sitemap": "^4.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "15.3.3",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "critters": "^0.0.23",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.3.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
